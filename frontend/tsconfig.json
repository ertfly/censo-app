{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        // Desligado no frontend: os tipos do Reka UI e dos componentes shadcn-vue
        // não são compatíveis com essa opção.
        "exactOptionalPropertyTypes": false,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "jsx": "preserve",
        "types": ["vite/client"],
        "noEmit": true,
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.vue"],
    "references": [{ "path": "../packages/contracts" }]
}
