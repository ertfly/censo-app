# Copie para .env e ajuste. O .env nunca é versionado.

# Porta publicada no host pelo nginx (produção).
APP_PORT=8080

# Arquivo do banco montado no backend de produção (somente leitura).
# Padrão: o censo.sqlite da raiz. Os testes E2E apontam para uma cópia.
DATABASE_FILE=./censo.sqlite

# Proteção contra bots (ADR 0017, 0019). Os três segredos são obrigatórios,
# com pelo menos 32 caracteres e diferentes entre si; sem eles o backend não sobe.
# Gere cada um com: openssl rand -hex 32
ALTCHA_HMAC_KEY=
SESSION_SECRET=
PROTECTION_LOG_KEY=

# Valores da proteção (spec 003). Os padrões abaixo valem se a variável faltar.
SESSION_TTL_SECONDS=1800
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BAN_SECONDS=60
# Dificuldade do desafio (ALTCHA v2, PBKDF2): iterações por tentativa e limite do
# contador sorteado. Calibrada na T041 da 003 (ver research.md R1).
ALTCHA_COST=5000
ALTCHA_COUNTER_MAX=1000
PROTECTION_LOG_RETENTION_DAYS=7
TRUSTED_PROXY_CIDR=172.28.0.0/24
